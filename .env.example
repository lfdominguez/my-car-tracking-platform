# PostgreSQL with PostGIS
# Compose uses POSTGRES_* below; local cargo run uses DATABASE_URL.
POSTGRES_USER=ctp
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=car_tracking
DATABASE_URL=postgres://ctp:replace-with-strong-db-password@localhost:5432/car_tracking

# HTTP
LISTEN_ADDR=0.0.0.0:8080
# Local: http://localhost:8080  |  Production: https://your.domain (enables Secure cookies + HSTS)
PUBLIC_BASE_URL=http://localhost:8080

# Environment mode (optional). If unset, local is inferred from PUBLIC_BASE_URL host
# (localhost / 127.0.0.1). Use production|staging to force strict secret checks.
# APP_ENV=development
# CTP_ENV=development

# Secrets — outside local dev each must be ≥32 chars, not a known default, and independent.
# Generate e.g.: openssl rand -base64 48
SESSION_SECRET=dev-only-change-me-use-openssl-rand
SECRETS_KEY=dev-only-independent-secrets-key-change
DEVICE_TOKEN_PEPPER=dev-only-independent-pepper-change

# Session TTLs
# SESSION_IDLE_HOURS=168
# SESSION_ABSOLUTE_DAYS=14

# Secrets Key Ring
# SECRETS_KEY_PREVIOUS=
# SECRETS_KEY_VERSION=2

# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Local photo storage (served only via authenticated GET /api/cars/{id}/photo)
UPLOAD_DIR=data/uploads

# Dev login (POST /auth/dev-login) — keep 0 unless local testing.
# Outside local dev this is refused unless I_REALLY_WANT_DEV_LOGIN=1.
ALLOW_DEV_LOGIN=0
# I_REALLY_WANT_DEV_LOGIN=0

# When behind a trusted reverse proxy, set to 1 so rate limits use X-Forwarded-For / X-Real-IP.
TRUST_FORWARDED_HEADERS=0

# Optional path to trunk-built SPA assets
# WEB_DIST=crates/web/dist

# Allow Cloudflare Web Analytics beacon in CSP script-src (default off).
# Does not enable 'unsafe-eval'. See deploy/README-web-dist.md.
# CSP_CLOUDFLARE_ANALYTICS=0

# MCP (/mcp) Host allow-list: hostname from PUBLIC_BASE_URL is always included,
# plus loopback. Add comma-separated extras if agents hit another name/IP.
# MCP_ALLOWED_HOSTS=lan.example,192.168.88.10
# Auto-finish open trips after N seconds without new samples (default 7200 = 2h)
# TRIP_STALE_FINISH_AFTER_SECS=7200
