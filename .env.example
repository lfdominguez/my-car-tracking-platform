# PostgreSQL with PostGIS
DATABASE_URL=postgres://postgres:postgres@localhost:5432/car_tracking

# HTTP
LISTEN_ADDR=0.0.0.0:8080
PUBLIC_BASE_URL=http://localhost:8080

# Sessions / device token hashing
SESSION_SECRET=change-me-to-a-long-random-string
DEVICE_TOKEN_PEPPER=change-me-device-pepper

# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Local photo storage
UPLOAD_DIR=data/uploads

# Set to 1 to enable POST /auth/dev-login for local testing without Google
ALLOW_DEV_LOGIN=1

# Optional path to trunk-built SPA assets
# WEB_DIST=crates/web/dist
