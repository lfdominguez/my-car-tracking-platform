  "space": {
    "0": "{raw.space.0}", "1": "{raw.space.1}", "2": "{raw.space.2}", "3": "{raw.space.3}",
    "4": "{raw.space.4}", "5": "{raw.space.5}", "6": "{raw.space.6}", "8": "{raw.space.8}",
    "10": "{raw.space.10}", "12": "{raw.space.12}", "16": "{raw.space.16}", "20": "{raw.space.20}", "24": "{raw.space.24}",

    "row-y": "{raw.space.1}",
    "row-x": "{raw.space.3}",
    "card-pad": "{raw.space.5}",
    "panel-gap": "{raw.space.3}",
    "section-y-mobile": "{raw.space.8}",
    "section-y-desktop": "{raw.space.12}",
    "gutter-mobile": "{raw.space.4}",
    "gutter-desktop": "{raw.space.8}",
    "stack-tight": "{raw.space.1}",
    "stack-loose": "{raw.space.4}"
  },

  "$comment-radius": "v2 replaced the 0px sharp-grid signature. `surface` is the dominant shape (cards, panels, modals) and therefore carries the signature; `control` is the slightly tighter radius for buttons and inputs; `chip` is fully round for status atoms and filter pills.",
  "radius": {
    "xs": "{raw.radius.xs}",
    "sm": "{raw.radius.sm}",
    "md": "{raw.radius.md}",
    "lg": "{raw.radius.lg}",
    "xl": "{raw.radius.xl}",
    "2xl": "{raw.radius.2xl}",
    "surface": "{raw.radius.lg}",
    "control": "{raw.radius.control}",
    "chip": "{raw.radius.pill}",
    "avatar": "{raw.radius.full}",
    "signature": "{raw.radius.lg}"
  },

  "motion": {
    "duration-instant": "{raw.motion.duration.instant}",
    "duration-fast": "{raw.motion.duration.fast}",
    "duration-medium": "{raw.motion.duration.medium}",
    "duration-entry": "{raw.motion.duration.entry}",
    "duration-slow": "{raw.motion.duration.slow}",
    "duration-bump": "{raw.motion.duration.bump}",
    "duration-ambient-pulse": "{raw.motion.duration.ambient-pulse}",
    "duration-ambient-shimmer": "{raw.motion.duration.ambient-shimmer}",
